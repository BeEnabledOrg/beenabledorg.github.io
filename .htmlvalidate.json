{
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "heading-level": "error",
    "no-implicit-button-type": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h71": "error"
  },
  "elements": ["html5"]
}
